# Copy this file to backend/.env and choose your own password.
# backend/.env is git-ignored - never commit it.

# Password for the SQL Server "sa" account (used by docker compose).
# SQL Server requires a strong password: 8+ characters with upper, lower, digits and a symbol.
# Avoid the characters @ : / # ? % in it, because it is placed inside a URL.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng_Passw0rd

# Only needed when running the app or the loader scripts outside Docker
# (replace the password with the one you chose above):
# DATABASE_URL=mssql+pyodbc://sa:YOUR_PASSWORD@localhost:1433/canwell?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
